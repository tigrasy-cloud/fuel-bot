BOT_TOKEN=вставь_токен_от_BotFather
# Как часто проверять подписки (секунды)
CHECK_INTERVAL_SEC=300
# Локальный веб-сервер карты (Mini App)
MAP_HOST=127.0.0.1
MAP_PORT=8080
# Публичный HTTPS-адрес карты для кнопки «🗺 Открыть карту» в Telegram,
# например https://xxxx.ngrok.io/map (без него кнопка скрыта)
WEBAPP_URL=
# Прокси для доступа к api.telegram.org (если заблокирован провайдером):
# PROXY_URL=socks5://127.0.0.1:1080  или  PROXY_URL=http://host:port
PROXY_URL=
# Свой прокси к Bot API (Cloudflare Worker, см. cloudflare_worker/README.md):
# API_BASE_URL=https://your-worker.workers.dev
API_BASE_URL=
# ID админов для команды /stats (через запятую, узнать: написать боту /stats)
ADMIN_IDS=
